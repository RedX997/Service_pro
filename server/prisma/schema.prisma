// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String
  company          String?
  address          String?
  status           String   @default("active")
  services         String[] @default([])
  assignedEmployee String?
  lastContact      DateTime?
  createdAt        DateTime @default(now())
  messages         Message[]
  timeEntries      TimeEntry[]
  tasks            Task[]
  activityLogs     ClientActivityLog[]
}

model Employee {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  mobile      String?
  role        String
  department  String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  timeEntries TimeEntry[]
  messages    Message[]
  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")
}

model Visitor {
  id           String    @id @default(uuid())
  name         String
  email        String?
  phone        String?
  purpose      String
  hostId       String?
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("active")
  notes        String?
  createdAt    DateTime  @default(now())
}

// Conversation between employee and client
model Conversation {
  id              String    @id @default(uuid())
  clientId        String
  employeeId      String
  lastMessageId   String?
  lastMessageAt   DateTime?
  unreadCount     Int       @default(0) // Unread count for employee
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  messages        Message[]
  
  @@unique([clientId, employeeId])
  @@index([clientId])
  @@index([employeeId])
  @@index([lastMessageAt])
}

// Enhanced Message Model with WhatsApp features
model Message {
  id              String    @id @default(uuid())
  conversationId  String?   // Made optional for migration
  content         String    @db.Text
  senderId        String
  senderType      String    // 'client' | 'employee'
  clientId        String    // For backward compatibility
  
  // WhatsApp-like status
  isRead          Boolean   @default(false)
  isDelivered     Boolean   @default(false)
  isEdited        Boolean   @default(false)
  
  // Reply feature
  replyToId       String?
  
  // Reactions (JSON: {userId: emoji})
  reactions       Json?
  
  // Timestamps
  timestamp       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  editedAt        DateTime?
  
  // Relations
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id])
  employee        Employee?     @relation(fields: [senderId], references: [id])
  replyTo         Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]     @relation("MessageReplies")
  
  @@index([conversationId])
  @@index([senderId])
  @@index([timestamp])
  @@index([clientId])
}

// User online status
model UserStatus {
  userId          String    @id
  userType        String    // 'employee' | 'client'
  isOnline        Boolean   @default(false)
  lastSeen        DateTime  @default(now())
  socketId        String?
  
  @@index([isOnline])
  @@index([userType])
}

model TimeEntry {
  id         String    @id @default(uuid())
  employeeId String
  clientId   String
  serviceId  String
  startTime  DateTime
  endTime    DateTime?
  duration   Int?      // in minutes
  notes      String?
  createdAt  DateTime  @default(now())

  employee   Employee  @relation(fields: [employeeId], references: [id])
  client     Client    @relation(fields: [clientId], references: [id])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  employees   Int      @default(0)
  services    Int      @default(0)
  activeClients Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("pending") // pending, in_progress, completed, cancelled
  assignedTo  String
  assignedBy  String?
  clientId    String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee    Employee @relation("AssignedTasks", fields: [assignedTo], references: [id])
  assigner    Employee? @relation("CreatedTasks", fields: [assignedBy], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])
}
// RBAC (Role-Based Access Control) Models
model Role {
  id         Int      @id @default(autoincrement())
  role_name  String   @unique @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)
  
  // One-to-many relationship: One Role → Many Users
  users      User[]

  @@map("roles")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.Text
  role_id    Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  
  // Many-to-one relationship: Many Users → One Role
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  
  // One-to-many relationship: One User → Many Notifications
  notifications Notification[]
  
  // One-to-many relationship: One User → Many Activity Logs
  activityLogs ClientActivityLog[]

  @@index([email])
  @@index([role_id])
  @@map("users")
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String   @db.VarChar(50) // 'visitor', 'message', 'appointment', 'timer', 'task', 'system'
  title      String   @db.VarChar(255)
  message    String   @db.Text
  data       Json?    // Additional metadata (clientId, visitorId, etc.)
  read       Boolean  @default(false)
  priority   String   @default("normal") @db.VarChar(20) // 'low', 'normal', 'high', 'urgent'
  actionUrl  String?  @db.VarChar(500) // Optional URL to navigate when clicked
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  expiresAt  DateTime? @db.Timestamp(6) // Optional expiration for temporary notifications
  
  // Many-to-one relationship: Many Notifications → One User
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}


// Client Activity Log Model - Audit Trail
model ClientActivityLog {
  id          String   @id @default(cuid())
  clientId    String
  performedBy Int
  action      String   @db.VarChar(50) // CLIENT_CREATED, CLIENT_UPDATED, STATUS_CHANGED, etc.
  description String   @db.Text // Human-readable description
  metadata    Json?    // Detailed snapshot of what changed
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  
  // Many-to-one relationships
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User     @relation(fields: [performedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId])
  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("client_activity_logs")
}
