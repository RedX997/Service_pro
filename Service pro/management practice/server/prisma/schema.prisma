// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String
  company          String?
  address          String?
  status           String   @default("active")
  services         String[] @default([])
  assignedEmployee String?
  lastContact      DateTime?
  avatarUrl        String?  @db.Text
  createdAt        DateTime @default(now())
  messages         Message[]
  timeEntries      TimeEntry[]
  tasks            Task[]
  activityLogs     ClientActivityLog[]
}

model Employee {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String?
  mobile       String?
  role         String
  department   String?             // Primary department (backward compat)
  departments  String[] @default([]) // All assigned departments
  status       String   @default("active")
  avatarUrl    String?  @db.Text
  createdAt    DateTime @default(now())
  timeEntries  TimeEntry[]
  assignedTasks Task[]  @relation("AssignedTasks")
  createdTasks  Task[]  @relation("CreatedTasks")
  departmentMemberships EmployeeDepartment[]
}

model Visitor {
  id           String    @id @default(uuid())
  name         String
  email        String?
  phone        String?
  purpose      String
  hostId       String?
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("active")
  notes        String?
  createdAt    DateTime  @default(now())
}

// Conversation between employee and client
model Conversation {
  id              String    @id @default(uuid())
  clientId        String
  employeeId      String
  lastMessageId   String?
  lastMessageAt   DateTime?
  unreadCount     Int       @default(0) // Unread count for employee
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  messages        Message[]
  
  @@unique([clientId, employeeId])
  @@index([clientId])
  @@index([employeeId])
  @@index([lastMessageAt])
}

// Enhanced Message Model with WhatsApp features
model Message {
  id              String    @id @default(uuid())
  conversationId  String?   // Made optional for migration
  content         String    @db.Text
  senderId        String
  senderType      String    // 'client' | 'employee'
  clientId        String    // For backward compatibility
  
  // WhatsApp-like status
  isRead          Boolean   @default(false)
  isDelivered     Boolean   @default(false)
  isEdited        Boolean   @default(false)
  
  // Reply feature
  replyToId       String?
  
  // Reactions (JSON: {userId: emoji})
  reactions       Json?
  
  // Timestamps
  timestamp       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  editedAt        DateTime?
  
  // Relations
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id])
  // Removed employee foreign key - senderId can be either employee or client ID
  replyTo         Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]     @relation("MessageReplies")
  
  @@index([conversationId])
  @@index([senderId])
  @@index([timestamp])
  @@index([clientId])
}

// User online status
model UserStatus {
  userId          String    @id
  userType        String    // 'employee' | 'client'
  isOnline        Boolean   @default(false)
  lastSeen        DateTime  @default(now())
  socketId        String?
  
  @@index([isOnline])
  @@index([userType])
}

model TimeEntry {
  id         String    @id @default(uuid())
  employeeId String
  clientId   String
  serviceId  String
  startTime  DateTime
  endTime    DateTime?
  duration   Int?      // in minutes
  notes      String?
  createdAt  DateTime  @default(now())

  employee   Employee  @relation(fields: [employeeId], references: [id])
  client     Client    @relation(fields: [clientId], references: [id])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  employees   Int      @default(0)
  services    Int      @default(0)
  activeClients Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberOf    EmployeeDepartment[]
}

// Many-to-many junction: Employee ↔ Department
model EmployeeDepartment {
  id           String     @id @default(uuid())
  employeeId   String
  departmentId String
  assignedAt   DateTime   @default(now())

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, departmentId])  // Prevents duplicate assignments
  @@index([employeeId])
  @@index([departmentId])
  @@map("employee_departments")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("pending") // pending, in_progress, completed, cancelled
  assignedTo  String
  assignedBy  String?
  clientId    String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee    Employee @relation("AssignedTasks", fields: [assignedTo], references: [id])
  assigner    Employee? @relation("CreatedTasks", fields: [assignedBy], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])
}

// Appointment Model
model Appointment {
  id            String   @id @default(uuid())
  clientId      String
  employeeId    String
  contactPerson String
  date          DateTime
  time          String   // Stored as "10:00 AM" format
  duration      String   // "1h", "30m", etc.
  type          String   // "in-person", "video", "phone"
  purpose       String
  notes         String?
  status        String   @default("scheduled") // "scheduled", "in-progress", "completed", "cancelled"
  
  // Optional fields based on type
  meetingLink   String?  // For video calls
  location      String?  // For in-person meetings
  phoneNumber   String?  // For phone calls
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([clientId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// Cascade Admin Credential Log
model CascadeCredential {
  id             Int      @id @default(autoincrement())
  full_name      String   @db.VarChar(100)
  role_name      String   @db.VarChar(50)
  system_email   String   @unique @db.VarChar(150)
  personal_email String   @db.VarChar(150)
  plain_password String   @db.VarChar(100)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  @@map("cascade_credentials")
}

// RBAC (Role-Based Access Control) Models
model Role {
  id         Int      @id @default(autoincrement())
  role_name  String   @unique @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)
  
  // One-to-many relationship: One Role → Many Users
  users      User[]

  @@map("roles")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(100)
  password       String   @db.Text
  role_id        Int
  personal_email String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  job_title      String?  @db.VarChar(100)
  department     String?  @db.VarChar(100)
  
  // New Settings Fields
  phone          String?  @db.VarChar(50)
  address        String?  @db.Text
  city           String?  @db.VarChar(100)
  state          String?  @db.VarChar(100)
  zip            String?  @db.VarChar(20)
  timezone       String?  @db.VarChar(50) @default("System Default")

  // Appearance Fields
  theme            String?  @db.VarChar(20) @default("light")
  compactView      Boolean? @default(false)
  showWelcome      Boolean? @default(true)
  showQuickActions Boolean? @default(true)
  highContrast     Boolean? @default(false)
  fontSize         String?  @db.VarChar(20) @default("Medium")
  avatar_url       String?  @db.Text

  last_login_at  DateTime? @db.Timestamp(6)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  
  role           Role     @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notifications  Notification[]
  activityLogs   ClientActivityLog[]
  sessions       UserSession[]
  tickets        SupportTicket[]

  @@index([email])
  @@index([role_id])
  @@map("users")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  user_id          Int
  logged_in_at     DateTime  @default(now()) @db.Timestamp(6)
  logged_out_at    DateTime? @db.Timestamp(6)
  duration_minutes Int?
  ip_address       String?   @db.VarChar(50)

  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([logged_in_at])
  @@map("user_sessions")
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String   @db.VarChar(50) // 'visitor', 'message', 'appointment', 'timer', 'task', 'system'
  title      String   @db.VarChar(255)
  message    String   @db.Text
  data       Json?    // Additional metadata (clientId, visitorId, etc.)
  read       Boolean  @default(false)
  priority   String   @default("normal") @db.VarChar(20) // 'low', 'normal', 'high', 'urgent'
  actionUrl  String?  @db.VarChar(500) // Optional URL to navigate when clicked
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  expiresAt  DateTime? @db.Timestamp(6) // Optional expiration for temporary notifications
  
  // Many-to-one relationship: Many Notifications → One User
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}


// Client Activity Log Model - Audit Trail
model ClientActivityLog {
  id          String   @id @default(cuid())
  clientId    String
  performedBy Int
  action      String   @db.VarChar(50) // CLIENT_CREATED, CLIENT_UPDATED, STATUS_CHANGED, etc.
  description String   @db.Text // Human-readable description
  metadata    Json?    // Detailed snapshot of what changed
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  
  // Many-to-one relationships
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User     @relation(fields: [performedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId])
  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("client_activity_logs")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      Int
  subject     String
  message     String   @db.Text
  category    String   // 'bug', 'feature_request', 'account', 'other'
  priority    String   @default("medium") // 'low', 'medium', 'high', 'urgent'
  status      String   @default("open") // 'open', 'in_progress', 'resolved', 'closed'
  adminReply  String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}
